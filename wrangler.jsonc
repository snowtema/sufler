{
  // Статический сайт на Workers Static Assets: без скрипта, только файлы из public/
  "name": "sufler",
  "account_id": "49692a68920d96ed006d4d502d604cd6",
  "compatibility_date": "2026-09-20",
  // Перед деплоем и wrangler dev: архив скилла, llms-full.txt и sitemap.xml (scripts/build.mjs)
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "sufler.artemslizhik.com", "custom_domain": true }
  ]
}
